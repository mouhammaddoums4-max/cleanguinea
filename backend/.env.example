# Copier ce fichier en .env puis renseigner les vraies valeurs.
# .env est ignore par git : ne jamais commiter de secret.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=10&pool_timeout=60&connect_timeout=30"
JWT_SECRET="remplacer-par-une-chaine-aleatoire-longue"
JWT_EXPIRES_IN="30d"
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Integrations Mobile Money (laisser vide en developpement)
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""

# Passerelle SMS - NimbaSMS (https://www.nimbasms.com/)
# SERVICE_ID et SECRET_TOKEN de votre compte NimbaSMS.
SMS_PROVIDER="nimbasms"
SMS_API_KEY="votre-service-id"
SMS_API_SECRET="votre-secret-token"
SMS_SENDER_ID="CleanGuinee"
# Garde-fou : hors production, les SMS sont seulement affiches en console.
# Passez a "true" uniquement pour tester un envoi reel, en sachant que chaque
# message consomme du credit et part vers un vrai telephone.
SMS_ENVOI_REEL="false"

# Stockage des images - Cloudinary (https://cloudinary.com/)
# Le secret ne quitte JAMAIS le serveur : l'application demande une signature
# puis televerse directement vers Cloudinary.
CLOUDINARY_CLOUD_NAME="votre-cloud-name"
CLOUDINARY_API_KEY="votre-api-key"
CLOUDINARY_API_SECRET="votre-api-secret"
CLOUDINARY_DOSSIER="cleanguinea"
