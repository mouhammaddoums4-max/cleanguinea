// Clean Guinee - schema de donnees
// Aligne sur les maquettes : application client, application collecteur, back-office web.
// Base : PostgreSQL. La chaine de connexion vit dans backend/.env (jamais commite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerations
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  COLLECTEUR
  SUPERVISEUR
  ADMIN
}

/// Les trois bacs remis a chaque client, tels qu ils apparaissent dans l application.
enum CategorieDechet {
  PLASTIQUE // Bac 1 - bleu
  METAL_FER // Bac 2 - jaune
  AUTRES    // Bac 3 - gris
  CARTON
  VERRE
  ORGANIQUE
  REFUS
}

/// Un foyer ou une societe : le volume, la facturation et l interlocuteur
/// different, et le back-office doit pouvoir les distinguer des l inscription.
enum TypeClient {
  PARTICULIER
  ENTREPRISE
}

enum TypeOffre {
  ESSENTIEL // 2 passages / semaine
  STANDARD  // 3 passages / semaine - offre mise en avant dans l application
  PRO       // 6 passages / semaine, volume negocie
}

/// Duree d'engagement choisie par le client. Un engagement long est remise :
/// il ameliore la tresorerie et reduit le cout de recouvrement.
enum Periodicite {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
}

enum StatutAbonnement {
  ACTIF
  SUSPENDU // impaye de plus de 45 jours
  RESILIE
}

/// Deux origines de mission : la tournee planifiee, ou le bouton
/// "Ma poubelle est pleine" de l application client.
enum OrigineMission {
  PLANIFIEE
  DEMANDE_IMMEDIATE
  DEMANDE_PROGRAMMEE
}

/// Reprend exactement le suivi en temps reel de l ecran client :
/// Acceptee -> En route -> Arrive -> Terminee
enum StatutMission {
  EN_ATTENTE
  ACCEPTEE
  EN_ROUTE
  ARRIVE
  TERMINEE
  ANNULEE
  MANQUEE
}

enum MoyenPaiement {
  ORANGE_MONEY
  MTN_MOMO
  VISA
  MASTERCARD
  ESPECES
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
  REMBOURSE
}

enum SensPoints {
  CREDIT
  DEBIT
}

enum TypeConversion {
  REDUCTION_ABONNEMENT
  CREDIT_MOBILE_MONEY
  BON_PARTENAIRE
  CADEAU_CATALOGUE
  DON_ASSOCIATION
}

/// Etat d une zone confiee a un collecteur pour la journee.
enum StatutTournee {
  A_FAIRE
  EN_COURS
  TERMINEE
  ANNULEE
}

/// Categories de notification. Le client peut en desactiver certaines ;
/// PAIEMENT reste toujours active, un impaye suspendant le service.
enum TypeNotification {
  COLLECTE_PLANIFIEE
  COLLECTEUR_EN_ROUTE
  COLLECTE_TERMINEE
  POINTS_CREDITES
  PAIEMENT_DU
  PAIEMENT_RECU
  ZONE_AFFECTEE
  INFORMATION
}

enum CanalNotification {
  PUSH
  SMS
  LES_DEUX
}

enum NiveauAlerte {
  INFO
  ATTENTION
  CRITIQUE
}

// ---------------------------------------------------------------------------
// Territoire
// ---------------------------------------------------------------------------

model Commune {
  id        String     @id @default(cuid())
  nom       String     @unique // Ratoma, Matam, Dixinn, Matoto, Kaloum
  quartiers Quartier[]
  createdAt DateTime   @default(now())
}

model Quartier {
  id        String    @id @default(cuid())
  nom       String // Cite FOFANA, Cite Faranah, Cite Miniere...
  communeId String
  commune   Commune   @relation(fields: [communeId], references: [id])
  latitude  Float?
  longitude Float?
  clients     Client[]
  collecteurs Collecteur[]
  missions    Mission[]
  tournees    Tournee[]
  createdAt DateTime  @default(now())

  @@unique([communeId, nom])
}

// ---------------------------------------------------------------------------
// Utilisateurs
// ---------------------------------------------------------------------------

model User {
  id         String   @id @default(cuid())
  telephone  String   @unique // +224 622 12 34 56
  email      String?  @unique
  nom        String
  motDePasse String // hash bcrypt
  role       Role     @default(CLIENT)
  photoUrl   String?
  langue     String   @default("fr") // bascule FR / EN de l ecran de bienvenue
  actif      Boolean  @default(true)
  /// Suppression de compte : les donnees personnelles sont effacees et le compte
  /// desactive, mais l historique financier est conserve (obligation comptable).
  supprimeLe DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client           Client?
  collecteur       Collecteur?
  mouvementsPoints MouvementPoints[]
  notifications    Notification[]
  appareils        AppareilPush[]
  preferencesNotif PreferenceNotification[]
  operationsSync   OperationSync[]

  @@index([role])
}

model Client {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TypeClient @default(PARTICULIER)
  adresse     String // "Cite FOFANA, Ratoma"
  quartierId  String
  quartier    Quartier @relation(fields: [quartierId], references: [id])
  latitude    Float?
  longitude   Float?
  nbPersonnes Int      @default(6)
  notes       String? // "Sortir le bac devant la porte." - visible par le collecteur
  createdAt   DateTime @default(now())

  bacs        Bac[]
  abonnements Abonnement[]
  missions    Mission[]
  paiements   Paiement[]

  @@index([quartierId])
}

/// Statut d'emploi d'un collecteur. Un compte suspendu ne peut plus se
/// connecter mais reste rattache a son historique de collectes.
enum StatutCollecteur {
  ACTIF
  CONGE
  SUSPENDU
  SORTI
}

model Collecteur {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matricule    String   @unique // COL-001

  // --- Etat civil et coordonnees -------------------------------------------
  photoUrl       String?
  dateNaissance  DateTime?
  adresse        String?
  quartierId     String?
  quartier       Quartier? @relation(fields: [quartierId], references: [id])
  pieceIdentite  String? // numero de CNI ou de passeport

  // --- Personne a prevenir -------------------------------------------------
  // Metier a risque : chutes, coupures, accidents de circulation. Un numero
  // joignable immediatement fait partie du minimum.
  urgenceNom      String?
  urgenceTelephone String?
  urgenceLien     String? // conjoint, frere, voisin...

  // --- Emploi --------------------------------------------------------------
  statut        StatutCollecteur @default(ACTIF)
  dateEmbauche  DateTime?
  dateSortie    DateTime?
  typeContrat   String? // CDD, CDI, prestataire
  vehicule      String? // immatriculation du tricycle ou de la camionnette

  note         Float    @default(5.0) // note moyenne affichee au client (ex. 4,8)
  nbEvaluations Int     @default(0)
  disponible   Boolean  @default(true)
  latitude     Float? // derniere position connue, pour le suivi temps reel
  longitude    Float?
  positionMaj  DateTime?
  createdAt    DateTime @default(now())
  // @default en plus de @updatedAt : sans lui, ajouter la colonne sur une table
  // deja peuplee exigerait de vider la table.
  updatedAt    DateTime @default(now()) @updatedAt

  missions    Mission[]
  tournees    Tournee[]
  evaluations Evaluation[]
}

// ---------------------------------------------------------------------------
// Offres et abonnements
// ---------------------------------------------------------------------------

model Offre {
  id                 String    @id @default(cuid())
  type               TypeOffre @unique
  libelle            String // "Abonnement Standard"
  tarifMensuelGnf    Int // 50 000
  passagesParSemaine Int
  nbBacsFournis      Int       @default(3)
  actif              Boolean   @default(true)

  abonnements Abonnement[]
}

model Abonnement {
  id            String           @id @default(cuid())
  reference     String           @unique // CG-2026-000001
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id])
  offreId       String
  offre         Offre            @relation(fields: [offreId], references: [id])
  periodicite   Periodicite      @default(MENSUEL)
  statut        StatutAbonnement @default(ACTIF)
  dateDebut     DateTime         @default(now())
  dateFin       DateTime?
  prochainPrelevement DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  paiements Paiement[]

  @@index([clientId])
  @@index([statut])
}

// ---------------------------------------------------------------------------
// Bacs
// ---------------------------------------------------------------------------

model Bac {
  id           String          @id @default(cuid())
  /// Contenu du QR colle sur le bac : il porte l'identifiant du client suivi
  /// du numero de bac, par exemple CG-2026-000001-B1. Le collecteur qui scanne
  /// sait donc immediatement chez qui il se trouve, meme hors reseau.
  codeQr       String          @unique
  numero       Int // 1 ou 2 - "Bac 1", "Bac 2"
  categorie    CategorieDechet
  volumeLitres Int             @default(240)
  /// Etat physique, renseigne par l'administrateur lors des inventaires.
  etat         String          @default("BON") // BON | ABIME | PERDU | REMPLACE
  imprimeLe    DateTime?
  /// Niveau de remplissage declare par le client : 0 a 3 tiers (0/3 a 3/3 plein).
  niveauTiers  Int             @default(0)
  clientId     String?
  client       Client?         @relation(fields: [clientId], references: [id])
  enService    Boolean         @default(true)
  dateRemise   DateTime?
  createdAt    DateTime        @default(now())

  missions MissionBac[]
  pesees   Pesee[]

  @@unique([clientId, numero])
  @@index([categorie])
}

// ---------------------------------------------------------------------------
// Tournees de zone
//
// C est l unite de travail du collecteur : une zone (quartier) a collecter dans
// la journee. Il la demarre, la collecte, puis la confirme en saisissant les
// poids releves. Les missions individuelles du quartier sont cloturees avec elle.
// ---------------------------------------------------------------------------

model Tournee {
  id        String @id @default(cuid())
  /// Reference affichee au collecteur : Z-2026-0001
  reference String @unique

  /// UUID genere par l application avant l envoi : garantit qu une zone confirmee
  /// hors reseau puis synchronisee deux fois ne compte qu une seule fois.
  clientRef String? @unique

  date         DateTime      @db.Date
  quartierId   String
  quartier     Quartier      @relation(fields: [quartierId], references: [id])
  collecteurId String
  collecteur   Collecteur    @relation(fields: [collecteurId], references: [id])
  statut       StatutTournee @default(A_FAIRE)

  /// Creneau annonce, repris de la planification.
  heureDebutPrevue DateTime?
  heureFinPrevue   DateTime?

  demarreeA  DateTime?
  termineeA  DateTime?

  /// Renseignes a la confirmation.
  nbFoyersServis Int    @default(0)
  poidsTotalKg   Float  @default(0)
  latitude       Float?
  longitude      Float?
  photoUrl       String?
  commentaire    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missions Mission[]
  pesees   Pesee[]

  @@unique([date, quartierId, collecteurId])
  @@index([collecteurId, date])
  @@index([statut])
}

// ---------------------------------------------------------------------------
// Missions de collecte
// ---------------------------------------------------------------------------

model Mission {
  id        String @id @default(cuid())
  /// Reference affichee partout dans les interfaces : #M-1256
  reference String @unique

  /// UUID genere par l application collecteur avant l envoi. Garantit l idempotence
  /// quand une tournee saisie hors ligne est synchronisee plusieurs fois.
  clientRef String? @unique

  clientId     String
  client       Client         @relation(fields: [clientId], references: [id])
  quartierId   String
  quartier     Quartier       @relation(fields: [quartierId], references: [id])
  collecteurId String?
  collecteur   Collecteur?    @relation(fields: [collecteurId], references: [id])
  /// Renseigne quand la mission est cloturee par la confirmation d une zone.
  tourneeId    String?
  tournee      Tournee?       @relation(fields: [tourneeId], references: [id])
  origine      OrigineMission @default(PLANIFIEE)
  statut       StatutMission  @default(EN_ATTENTE)

  datePlanifiee  DateTime // date + heure planifiee (08:00)
  fenetreFin     DateTime? // fin du creneau annonce au client (10:00)
  accepteeA      DateTime?
  enRouteA       DateTime?
  arriveeA       DateTime?
  termineeA      DateTime?
  etaMinutes     Int? // "Arrivee estimee 12 min"

  latitude    Float?
  longitude   Float?
  photoUrl    String? // photo du bac prise a la collecte
  poidsTotalKg Float   @default(0)
  commentaire String?
  motifAnnulation String?

  /// Double confirmation : le collecteur declare avoir collecte, le client
  /// confirme de son cote. Un ecart entre les deux revele une collecte non
  /// faite, ou une contestation a arbitrer.
  confirmeParClient   Boolean   @default(false)
  confirmeParClientLe DateTime?
  contesteParClient   Boolean   @default(false)
  motifContestation   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bacs       MissionBac[]
  pesees     Pesee[]
  evaluation Evaluation?

  @@index([clientId])
  @@index([collecteurId])
  @@index([statut])
  @@index([datePlanifiee])
}

/// Une mission peut porter sur plusieurs bacs (colonne "Bac(s)" du back-office).
model MissionBac {
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  bacId     String
  bac       Bac     @relation(fields: [bacId], references: [id])

  @@id([missionId, bacId])
}

/// Une pesee provient soit d une mission individuelle (demande d un foyer),
/// soit de la confirmation d une zone entiere. Exactement l une des deux.
model Pesee {
  id        String          @id @default(cuid())
  missionId String?
  mission   Mission?        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  tourneeId String?
  tournee   Tournee?        @relation(fields: [tourneeId], references: [id], onDelete: Cascade)
  bacId     String?
  bac       Bac?            @relation(fields: [bacId], references: [id])
  categorie CategorieDechet
  poidsKg   Float

  /// false = saisie manuelle au lieu de la balance Bluetooth : a controler.
  peseeCertifiee   Boolean @default(true)
  contaminationPct Float?
  /// Contamination superieure a 15% : les points sont ramenes a 50%.
  declassee        Boolean @default(false)
  photoUrl         String?
  createdAt        DateTime @default(now())

  mouvementPoints MouvementPoints?

  @@index([missionId])
  @@index([tourneeId])
  @@index([categorie])
}

model Evaluation {
  id           String     @id @default(cuid())
  missionId    String     @unique
  mission      Mission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  collecteurId String
  collecteur   Collecteur @relation(fields: [collecteurId], references: [id])
  note         Int // 1 a 5
  commentaire  String?
  createdAt    DateTime   @default(now())

  @@index([collecteurId])
}

// ---------------------------------------------------------------------------
// Programme Points Clean
// ---------------------------------------------------------------------------

model BaremePoints {
  id          String          @id @default(cuid())
  categorie   CategorieDechet @unique
  pointsParKg Int
  actif       Boolean         @default(true)
  dateEffet   DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Referentiels de configuration
//
// Tout ce qui etait auparavant code en dur dans l application vit ici : libelles,
// couleurs, taux, seuils. Modifiable depuis le back-office sans redeploiement.
// ---------------------------------------------------------------------------

/// Referentiel des categories de dechets : libelles bilingues et couleur d affichage.
/// Consomme par l application mobile et le back-office via GET /api/config.
model CategorieConfig {
  id        String          @id @default(cuid())
  code      CategorieDechet @unique
  libelleFr String
  libelleEn String
  couleur   String // hexadecimal, ex. #2563EB
  couleurFond String // teinte claire pour les pastilles
  icone     String          @default("trash")
  /// Compte dans le quota mensuel de recyclables et dans le taux de valorisation.
  recyclable Boolean        @default(true)
  ordre     Int             @default(0)
  actif     Boolean         @default(true)
}

/// Taux de conversion des Points Clean, par destination.
/// Le nombre de points requis pour 1 000 GNF varie selon le canal : le credit
/// Mobile Money coute plus cher car il supporte la commission de l operateur.
model TauxConversion {
  id             String         @id @default(cuid())
  type           TypeConversion @unique
  libelleFr      String
  libelleEn      String
  pointsPour1000Gnf Int
  /// Plafond mensuel en GNF. null = aucun plafond.
  plafondMensuelGnf Int?
  soldeMinimumPoints Int        @default(0)
  actif          Boolean        @default(true)
  ordre          Int            @default(0)
}

/// Niveaux de fidelite du programme Points Clean.
model NiveauFidelite {
  id        String @id @default(cuid())
  code      String @unique // BRONZE / ARGENT / OR / CHAMPION
  libelleFr String
  libelleEn String
  seuil     Int // points cumules sur 12 mois
  bonusPct  Int    @default(0)
  ordre     Int    @default(0)
}

/// Remise accordee selon la duree d'engagement.
model TarifPeriodicite {
  id          String      @id @default(cuid())
  periodicite Periodicite @unique
  /// Nombre de mois facturés en une fois.
  mois        Int
  /// Remise appliquee au total, en pourcentage.
  remisePct   Int         @default(0)
  libelleFr   String
  libelleEn   String
  ordre       Int         @default(0)
  actif       Boolean     @default(true)
}

/// Parametres scalaires de l application (cle -> valeur typee).
/// Evite de multiplier les tables pour des reglages isoles.
model Parametre {
  id          String   @id @default(cuid())
  cle         String   @unique // points.gnfParPoint, fraude.plafondKgMois...
  valeur      String // toujours stocke en texte, converti par `type`
  type        String   @default("string") // string | number | boolean | json
  libelleFr   String
  libelleEn   String
  groupe      String   @default("general")
  modifiable  Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model SoldePoints {
  id           String   @id @default(cuid())
  userId       String   @unique
  solde        Int      @default(0)
  cumule12Mois Int      @default(0)
  niveau       String   @default("BRONZE") // BRONZE / ARGENT / OR / CHAMPION
  updatedAt    DateTime @updatedAt
}

model MouvementPoints {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sens       SensPoints
  points     Int
  motif      String // "Pesee plastique 8,5 kg", "Bonus regularite"
  peseeId    String?         @unique
  pesee      Pesee?          @relation(fields: [peseeId], references: [id])
  conversion TypeConversion?
  /// Les points expirent 18 mois apres leur credit.
  expireLe   DateTime?
  createdAt  DateTime        @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Paiements
// ---------------------------------------------------------------------------

model Paiement {
  id           String     @id @default(cuid())
  reference    String     @unique
  /// Reprise de l'abonnement au moment du paiement : une periodicite modifiee
  /// plus tard ne doit pas reecrire l'historique comptable.
  periodicite  Periodicite @default(MENSUEL)
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id])
  abonnementId String?
  abonnement   Abonnement? @relation(fields: [abonnementId], references: [id])

  montantGnf      Int
  /// Part reglee en Points Clean convertis en reduction.
  remisePointsGnf Int            @default(0)
  moyen           MoyenPaiement
  statut          StatutPaiement @default(EN_ATTENTE)
  periodeDebut    DateTime
  periodeFin      DateTime
  /// Identifiant renvoye par Orange Money / MTN MoMo.
  refOperateur    String?
  payeLe          DateTime?
  createdAt       DateTime       @default(now())

  @@index([clientId])
  @@index([statut])
}

// ---------------------------------------------------------------------------
// Centre de tri, stock et ventes
// ---------------------------------------------------------------------------

model CentreTri {
  id                 String   @id @default(cuid())
  nom                String   @unique
  adresse            String
  capaciteTonnesMois Int
  actif              Boolean  @default(true)
  createdAt          DateTime @default(now())

  stocks Stock[]
  lots   Lot[]
}

/// Alimente le bloc "Stock par categorie" du tableau de bord.
model Stock {
  id            String          @id @default(cuid())
  centreTriId   String
  centreTri     CentreTri       @relation(fields: [centreTriId], references: [id])
  categorie     CategorieDechet
  quantiteKg    Float           @default(0)
  capaciteKg    Float // sert a calculer le taux de remplissage et l alerte
  updatedAt     DateTime        @updatedAt

  @@unique([centreTriId, categorie])
}

model Lot {
  id          String          @id @default(cuid())
  reference   String          @unique // LOT-PLA-2026-001
  centreTriId String
  centreTri   CentreTri       @relation(fields: [centreTriId], references: [id])
  categorie   CategorieDechet
  poidsKg     Float
  venteId     String?
  vente       Vente?          @relation(fields: [venteId], references: [id])
  createdAt   DateTime        @default(now())

  @@index([categorie])
}

model Acheteur {
  id        String   @id @default(cuid())
  nom       String   @unique
  contact   String?
  matieres  String?
  createdAt DateTime @default(now())

  ventes Vente[]
}

model Vente {
  id           String   @id @default(cuid())
  reference    String   @unique
  acheteurId   String
  acheteur     Acheteur @relation(fields: [acheteurId], references: [id])
  poidsTotalKg Float
  prixKgGnf    Int
  montantGnf   Int
  dateVente    DateTime @default(now())
  paye         Boolean  @default(false)
  createdAt    DateTime @default(now())

  lots Lot[]

  @@index([dateVente])
}

// ---------------------------------------------------------------------------
// Synchronisation hors ligne
// ---------------------------------------------------------------------------

/// Journal des operations recues depuis un appareil ayant travaille hors reseau.
///
/// Sert a deux choses : garantir qu'une meme operation rejouee n'est appliquee
/// qu'une fois (clientRef), et garder une trace de ce qui a echoue pour pouvoir
/// le rejouer ou l'expliquer. Sans ce journal, une synchronisation partielle
/// disparait sans laisser de piste.
model OperationSync {
  id        String @id @default(cuid())
  /// UUID genere sur l'appareil AVANT l'envoi.
  clientRef String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // scan_bac | collecte_mission | confirmer_zone | niveau_bac
  charge  Json   // corps de l'operation, tel qu'envoye
  statut  String @default("APPLIQUEE") // APPLIQUEE | ECHOUEE | IGNOREE
  erreur  String?

  /// Horodatage cote appareil : l'ordre reel des gestes du collecteur, qui
  /// n'est pas celui de leur arrivee au serveur.
  faiteA    DateTime
  recueA    DateTime @default(now())

  @@index([userId, recueA])
  @@index([statut])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/// Notification destinee a un utilisateur, conservee pour etre relue dans
/// l'application meme si la notification systeme a ete balayee.
model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    TypeNotification
  titre   String
  message String
  /// Route de l'application a ouvrir au clic, ex. /(client)/suivi
  lien    String?
  /// Contexte libre : reference de mission, montant, points credites.
  donnees Json?

  lue      Boolean   @default(false)
  lueLe    DateTime?
  envoyeePush Boolean @default(false)
  envoyeeSms  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, lue])
  @@index([createdAt])
}

/// Jeton push d'un appareil. Un utilisateur peut en avoir plusieurs
/// (telephone personnel et telephone de service, par exemple).
model AppareilPush {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Jeton Expo : ExponentPushToken[...]
  jeton     String   @unique
  plateforme String? // ios | android
  modele    String?
  actif     Boolean  @default(true)
  vuLe      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Preferences de notification, par type. L'absence de ligne vaut "active".
model PreferenceNotification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   TypeNotification
  push   Boolean          @default(true)
  sms    Boolean          @default(true)

  @@unique([userId, type])
}

// ---------------------------------------------------------------------------
// Bannieres de l'ecran d'accueil
// ---------------------------------------------------------------------------

/// Encart affiche en haut de l'accueil client : promotion, message de service,
/// campagne de tri. Pilote depuis le back-office, sans nouvelle version de l'app.
model Banniere {
  id          String   @id @default(cuid())
  titre       String
  titreEn     String?
  sousTitre   String?
  sousTitreEn String?
  imageUrl    String?
  /// Couleur de fond quand il n'y a pas d'image.
  couleur     String   @default("#16A34A")
  /// Route interne (/(client)/points) ou URL externe (https://...).
  lien        String?
  libelleAction   String?
  libelleActionEn String?

  actif     Boolean   @default(true)
  ordre     Int       @default(0)
  debutLe   DateTime?
  finLe     DateTime?

  /// Compteurs d'usage, pour savoir ce qui interesse reellement.
  vues     Int @default(0)
  clics    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif, ordre])
}

// ---------------------------------------------------------------------------
// Alertes du back-office
// ---------------------------------------------------------------------------

model Alerte {
  id        String       @id @default(cuid())
  niveau    NiveauAlerte @default(INFO)
  titre     String // "Stock plastique presque plein"
  message   String // "Capacite restante : 8%"
  lien      String? // route du back-office a ouvrir
  lue       Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([lue])
  @@index([createdAt])
}
