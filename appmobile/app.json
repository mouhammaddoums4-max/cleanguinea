{
  "expo": {
    "name": "Clean Guinée",
    "slug": "cleanguinea",
    "owner": "dumsky",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cleanguinea",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gn.cleanguinea.app"
    },
    "android": {
      "package": "gn.cleanguinea.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Clean Guinée utilise l'appareil photo pour scanner le QR code des bacs et photographier la collecte."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Clean Guinée utilise votre position pour le suivi des collectes en temps réel."
        }
      ],
      "expo-status-bar",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    },
    "backgroundColor": "#F9FAFB"
  }
}
