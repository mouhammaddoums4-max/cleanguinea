{
  "expo": {
    "name": "Sényi",
    "slug": "senyi",
    "owner": "dumsky",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "senyi",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gn.senyi.app"
    },
    "android": {
      "package": "gn.senyi.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Sényi utilise l'appareil photo pour scanner le QR code des bacs et photographier la collecte.",
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sényi utilise votre position pour le suivi des collectes en temps réel."
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      "expo-localization",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false
          },
          "ios": {
            "ccacheEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000",
      "router": {}
    },
    "backgroundColor": "#F9FAFB"
  }
}
